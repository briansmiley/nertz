# Copy to .env for local development (`npm run dev` reads it). In production set the same names as secrets on your
# host (on Fly: `fly secrets set NAME=value`). Everything here is optional: the game runs with none of it.

# --- Feedback (the bug button). A report goes to every place that is set up.
# A Discord webhook URL: channel settings > Integrations > Webhooks.
FEEDBACK_WEBHOOK=
# A directory to keep reports in (feedback.jsonl and the screenshots). In dev it defaults to ./feedback.
# FEEDBACK_DIR=

# A Linear personal API key and the key of the team to file issues in (the letters before an issue's number).
LINEAR_API_KEY=
LINEAR_TEAM=
# How those issues are filed. Leave any of them out to keep Linear's own default.
# 1 urgent, 2 high, 3 medium, 4 low
# LINEAR_PRIORITY=2
# An email address, or `me` for whoever the API key belongs to
# LINEAR_ASSIGNEE=me
# A status of that team, by name
# LINEAR_STATE=Todo
# A project, by name
# LINEAR_PROJECT=

# An Anthropic API key: Claude Haiku gives each report a short title and, for Linear, a priority by how bad it is (never Urgent)
# (over LINEAR_PRIORITY). Without it, an issue is titled by the report's first line.
# ANTHROPIC_API_KEY=

# --- Voice chat. Extra ICE servers (a TURN relay) as JSON, for players behind strict networks.
# ICE_SERVERS=[{"urls":"turn:example.com:3478","username":"user","credential":"secret"}]

# --- Ports for local development.
# PORT=8787
# VITE_PORT=5173
